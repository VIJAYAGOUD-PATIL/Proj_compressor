"""
OGV / OGG Video Player
Requirements: pip install pyglet
Run: python ogv_player.py
"""

import tkinter as tk
from tkinter import filedialog, messagebox, ttk
import threading
import time
import os

try:
    import pyglet
    from pyglet.media import Player
except ImportError:
    raise SystemExit("pyglet not found. Install it with:  pip install pyglet")

# ── Pyglet window embedded via HWND on Windows, or run separately ──────────
# For cross-platform simplicity we run pyglet in its own window and use
# tkinter only for the control panel.

class VideoApp:
    def __init__(self):
        self.player = None
        self.source = None
        self.filepath = None
        self.running = True
        self.duration = 0

        # ── Tkinter control panel ──────────────────────────────────────────
        self.root = tk.Tk()
        self.root.title("OGV / OGG Video Player")
        self.root.geometry("540x220")
        self.root.resizable(False, False)
        self.root.configure(bg="#1a1a2e")

        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TScale", background="#1a1a2e", troughcolor="#16213e",
                        sliderlength=14, sliderrelief="flat")

        # Title bar
        tk.Label(self.root, text="▶  OGV / OGG Player",
                 bg="#1a1a2e", fg="#e2e8f0",
                 font=("Courier New", 13, "bold")).pack(pady=(14, 2))

        # File path label
        self.file_label = tk.Label(self.root, text="No file loaded",
                                   bg="#1a1a2e", fg="#64748b",
                                   font=("Courier New", 9), wraplength=500)
        self.file_label.pack()

        # Seek bar
        self.seek_var = tk.DoubleVar()
        self.seek_bar = ttk.Scale(self.root, from_=0, to=100,
                                  orient="horizontal", variable=self.seek_var,
                                  length=500, command=self._on_seek)
        self.seek_bar.pack(pady=(10, 2))

        # Time label
        self.time_label = tk.Label(self.root, text="0:00 / 0:00",
                                   bg="#1a1a2e", fg="#94a3b8",
                                   font=("Courier New", 9))
        self.time_label.pack()

        # Buttons row
        btn_frame = tk.Frame(self.root, bg="#1a1a2e")
        btn_frame.pack(pady=10)

        btn_cfg = dict(bg="#0f3460", fg="#e2e8f0", activebackground="#e94560",
                       activeforeground="#fff", relief="flat",
                       font=("Courier New", 10), padx=12, pady=4, cursor="hand2")

        self.open_btn  = tk.Button(btn_frame, text="📂 Open",   command=self.open_file, **btn_cfg)
        self.play_btn  = tk.Button(btn_frame, text="▶ Play",    command=self.toggle_play, **btn_cfg, state="disabled")
        self.stop_btn  = tk.Button(btn_frame, text="■ Stop",    command=self.stop, **btn_cfg, state="disabled")

        self.open_btn.pack(side="left", padx=4)
        self.play_btn.pack(side="left", padx=4)
        self.stop_btn.pack(side="left", padx=4)

        # Volume slider
        vol_frame = tk.Frame(self.root, bg="#1a1a2e")
        vol_frame.pack()
        tk.Label(vol_frame, text="🔊", bg="#1a1a2e", fg="#94a3b8",
                 font=("Courier New", 10)).pack(side="left")
        self.vol_var = tk.DoubleVar(value=1.0)
        ttk.Scale(vol_frame, from_=0, to=1, orient="horizontal",
                  variable=self.vol_var, length=120,
                  command=self._on_volume).pack(side="left", padx=4)

        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

        # Background thread to update seek bar
        self._updater = threading.Thread(target=self._update_loop, daemon=True)
        self._updater.start()

        self.root.mainloop()

    # ── File handling ──────────────────────────────────────────────────────
    def open_file(self):
        path = filedialog.askopenfilename(
            title="Open Video File",
            filetypes=[
                ("OGG/OGV files", "*.ogv *.ogg"),
                ("WebM files",    "*.webm"),
                ("MP4 files",     "*.mp4"),
                ("All video",     "*.ogv *.ogg *.webm *.mp4 *.avi *.mkv"),
                ("All files",     "*.*"),
            ]
        )
        if not path:
            return
        self.filepath = path
        self.file_label.config(text=os.path.basename(path), fg="#e2e8f0")
        self._load(path)

    def _load(self, path):
        if self.player:
            self.player.pause()
            self.player.delete()

        try:
            self.source = pyglet.media.load(path)
        except Exception as e:
            messagebox.showerror("Load error", str(e))
            return

        self.duration = self.source.duration or 0
        self.player = Player()
        self.player.volume = self.vol_var.get()
        self.player.queue(self.source)
        self.player.play()

        self.play_btn.config(text="⏸ Pause", state="normal")
        self.stop_btn.config(state="normal")
        self.seek_var.set(0)

    # ── Controls ───────────────────────────────────────────────────────────
    def toggle_play(self):
        if not self.player:
            return
        if self.player.playing:
            self.player.pause()
            self.play_btn.config(text="▶ Play")
        else:
            self.player.play()
            self.play_btn.config(text="⏸ Pause")

    def stop(self):
        if self.player:
            self.player.pause()
            self.player.seek(0)
            self.play_btn.config(text="▶ Play")
            self.seek_var.set(0)
            self.time_label.config(text="0:00 / 0:00")

    def _on_seek(self, val):
        if self.player and self.duration:
            t = float(val) / 100 * self.duration
            self.player.seek(t)

    def _on_volume(self, val):
        if self.player:
            self.player.volume = float(val)

    # ── Update loop (runs in background thread) ────────────────────────────
    def _update_loop(self):
        while self.running:
            if self.player and self.duration:
                ct = self.player.time or 0
                pct = ct / self.duration * 100
                self.seek_var.set(pct)
                self.time_label.config(text=f"{self._fmt(ct)} / {self._fmt(self.duration)}")
            time.sleep(0.5)

    @staticmethod
    def _fmt(s):
        s = int(s)
        return f"{s // 60}:{s % 60:02d}"

    # ── Cleanup ────────────────────────────────────────────────────────────
    def on_close(self):
        self.running = False
        if self.player:
            self.player.pause()
            self.player.delete()
        self.root.destroy()


if __name__ == "__main__":
    # Tell pyglet not to open its own event loop window by default
    pyglet.options["shadow_window"] = False
    VideoApp()