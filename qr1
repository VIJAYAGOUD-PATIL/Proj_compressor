<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>QR Code</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f5f5;
  }
  #qrcode {
    padding: 16px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  p {
    margin-top: 16px;
    color: #333;
    word-break: break-all;
    max-width: 300px;
    text-align: center;
  }
</style>
</head>
<body>

<div id="qrcode"></div>
<p id="urlLabel"></p>

<script>
  // ↓↓↓ Replace this URL with your actual link ↓↓↓
  const targetUrl = "https://forms.gle/YOUR_CODE_HERE";

  document.getElementById("urlLabel").textContent = targetUrl;

  new QRCode(document.getElementById("qrcode"), {
    text: targetUrl,
    width: 256,
    height: 256,
    colorDark: "#000000",
    colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.H
  });
</script>

</body>
</html>